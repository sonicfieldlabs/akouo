{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akouo.dev/schemas/listening-common.schema.json",
  "$defs": {
    "span": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "control_id": {
          "type": "string",
          "minLength": 1
        },
        "gate": {
          "type": "string",
          "enum": [
            "input",
            "execution",
            "output",
            "retention",
            "disclosure"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "limit": {
          "type": "number",
          "minimum": 0
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "control_id",
        "gate",
        "target",
        "operator",
        "required"
      ]
    },
    "scope_path": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "workspace",
              "workflow",
              "swarm",
              "run",
              "invocation"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "ref"
        ]
      },
      "minItems": 1
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "full",
            "explicit_selection"
          ]
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        }
      },
      "required": [
        "policy",
        "max_bytes"
      ]
    }
  }
}
