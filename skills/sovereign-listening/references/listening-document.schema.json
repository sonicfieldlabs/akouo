{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akouo.dev/schemas/listening-document.schema.json",
  "title": "listening-document",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "akouo/listening-document/v1"
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "revision_ref": {
      "type": "string",
      "minLength": 1
    },
    "representation_ref": {
      "type": "string",
      "minLength": 1
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "byte_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "encoding": {
      "const": "utf-8"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "authored_at": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "enum": [
        "orientation",
        "research",
        "imagination",
        "covenant",
        "swarm",
        "other"
      ]
    },
    "lineage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "revision_of",
              "fork_of"
            ]
          },
          "revision_ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "kind",
          "revision_ref",
          "sha256"
        ]
      },
      "minItems": 0
    },
    "terms_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "contract",
    "document_id",
    "revision_ref",
    "representation_ref",
    "artifact_ref",
    "sha256",
    "byte_count",
    "encoding",
    "authors",
    "authored_at",
    "purpose",
    "lineage",
    "terms_ref"
  ]
}
