{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akouo.dev/schemas/record-workflow-request.schema.json",
  "title": "Bounded retained-record research, derivation and decision requests",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contract": {
          "const": "akouo/record-workflow/v0.1"
        },
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "actor_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "created_at": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "permissions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "record_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              },
              "status": {
                "const": "granted"
              },
              "permission_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "pattern": "\\S"
              }
            },
            "required": [
              "record_ref",
              "status",
              "permission_ref"
            ]
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "supported_contracts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true
        },
        "resolved_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "\\S"
          },
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true
        },
        "kind": {
          "const": "research"
        },
        "record_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S"
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "criterion",
              "evidence_refs",
              "relation_id"
            ],
            "properties": {
              "criterion": {
                "type": "object",
                "required": [
                  "input_refs"
                ],
                "properties": {
                  "input_refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "uniqueItems": true
                  }
                }
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "relation_id": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        }
      },
      "required": [
        "contract",
        "request_id",
        "actor_ref",
        "created_at",
        "source_refs",
        "permissions",
        "supported_contracts",
        "resolved_refs",
        "kind",
        "record_id",
        "question",
        "relations"
      ]
    },
    {
      "type": "object",
