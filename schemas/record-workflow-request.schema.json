          "maxLength": 4096,
          "pattern": "\\S"
        }
      },
      "required": [
        "contract",
        "request_id",
        "actor_ref",
        "created_at",
        "source_refs",
        "permissions",
        "supported_contracts",
        "resolved_refs",
        "kind",
        "prompt",
        "parameters",
        "policy_ref",
        "policy_revision"
      ]
    },
