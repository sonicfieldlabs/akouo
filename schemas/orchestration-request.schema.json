{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract": {
      "const": "akouo/orchestrate/v0.1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ears": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "participant_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "modes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "items": {
              "$ref": "listening-output.schema.json#/$defs/listening_mode"
            }
          }
        },
        "required": [
          "id",
          "participant_ref",
          "modes"
        ]
      }
    },
    "passes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "ear_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "depends_on": {
            "type": "array",
            "maxItems": 16,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "permission": {
            "enum": [
              "granted",
              "denied",
              "unknown"
            ]
          }
        },
        "required": [
          "id",
          "ear_ref",
          "depends_on",
          "permission"
        ]
      }
    },
    "direction": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "parameter",
                "ensemble",
                "agent",
                "person"
              ]
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "required": [
            "kind",
            "ref"
          ]
        }
      ]
    },
    "resolved_refs": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "dissolution_rule": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "contract",
    "request_id",
    "ears",
    "passes",
    "direction",
    "resolved_refs",
    "dissolution_rule"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akouo.dev/schemas/orchestration-request.schema.json",
  "title": "Declared orchestration request"
}
